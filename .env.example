APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Lifetime of the "remember me" cookie, in minutes (576000 = 400 days).
AUTH_REMEMBER_LIFETIME=576000
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

IGNITION_EDITOR=vscode

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Biometric face enrollment (optional; enrollment is blocked when unavailable)
BIOMETRIC_FACE_DRIVER=python
BIOMETRIC_PYTHON_BINARY=python3
BIOMETRIC_FACE_TIMEOUT=30
# BIOMETRIC_MIN_WIDTH=320
# BIOMETRIC_MIN_HEIGHT=320
# BIOMETRIC_MIN_SHARPNESS=6
# BIOMETRIC_MIN_SCORE=60
# BIOMETRIC_TEMPLATE_TTL_MONTHS=12
# BIOMETRIC_MATCH_METRIC=euclidean
# BIOMETRIC_MATCH_THRESHOLD=0.60
# BIOMETRIC_MAX_CANDIDATES=5
# BIOMETRIC_CONSENT_VERSION=2026-11-v1
